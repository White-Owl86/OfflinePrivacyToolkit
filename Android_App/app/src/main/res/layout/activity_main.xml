<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Top App Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🟢 100% Offline &amp; Air-Gapped"
                android:textColor="#2ECC71"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAuditBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Sockets"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#252525">

        <Button
            android:id="@+id/btnTabExif"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="EXIF"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#2ECC71"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabPdf"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="PDF"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTabOcr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="OCR"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTabSec"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Audit"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TAB 1: EXIF VIEW -->
        <ScrollView
            android:id="@+id/viewExif"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/exif_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/exif_desc"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/btnSelectExifImage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="@string/btn_select_image"
                        android:background="#2980B9"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnDoStripExif"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="@string/btn_strip_metadata"
                        android:background="#E74C3C"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExifFileInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/no_image_selected"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/metadata_inspection"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExifReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#1E1E1E"
                    android:padding="12dp"
                    android:fontFamily="monospace"
                    android:text="گزارش متاداده در این قسمت نمایش داده خواهد شد.\nMetadata details will appear here."
                    android:textColor="#2ECC71"
                    android:textSize="12sp" />

            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: PDF VIEW -->
        <ScrollView
            android:id="@+id/viewPdf"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pdf_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="انجام کلیه عملیات PDF به صورت کاملاً محلی و آفلاین بر روی رم و پردازنده گوشی."
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPdfSanitize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/pdf_sanitize_btn"
                    android:background="#27AE60"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnPdfConvertImg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pdf_images_to_pdf"
                    android:background="#2980B9"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvPdfStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="#2ECC71"
                    android:textSize="13sp" />

            </LinearLayout>
        </ScrollView>

        <!-- TAB 3: OCR VIEW -->
        <LinearLayout
            android:id="@+id/viewOcr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ocr_title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ocr_desc"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnSelectOcrDoc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/btn_select_ocr_doc"
                    android:background="#2980B9"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnExecuteOcr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_run_ocr"
                    android:background="#8E44AD"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <EditText
                android:id="@+id/etOcrOutput"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:background="#1E1E1E"
                android:gravity="top|start"
                android:hint="متن استخراج شده پس از پردازش اینجا نمایش داده می‌شود..."
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCopyOcrText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_copy_text"
                android:background="#34495E"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- TAB 4: SECURITY AUDIT VIEW -->
        <ScrollView
            android:id="@+id/viewSec"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/security_audit_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#1E3799"
                    android:padding="12dp"
                    android:text="@string/security_audit_desc"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="وضعیت ایزولاسیون شبکه (Air-Gap Audit):"
                    android:textColor="#2ECC71"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSecManifestReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#1E1E1E"
                    android:padding="12dp"
                    android:fontFamily="monospace"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</LinearLayout>
